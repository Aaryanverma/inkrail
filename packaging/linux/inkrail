#!/usr/bin/env python3
"""Launch Inkrail from a source checkout or an extracted Linux bundle."""

import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from inkrail_linux.main import main  # noqa: E402

arguments = sys.argv[1:]
bundle_ui = HERE / "ui"
if (bundle_ui / "index.html").is_file() and "--ui" not in arguments:
    arguments = ["--ui", str(bundle_ui)] + arguments

if __name__ == "__main__":
    sys.exit(main(arguments))
